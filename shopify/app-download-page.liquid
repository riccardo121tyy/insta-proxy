/* ---------- Install guide sheet (stile Apple) ---------- */

.came-app-sheet-backdrop {
  position: fixed;
  inset: 0;
  z-index: 2147483647;
  display: none;
  align-items: flex-end;
  justify-content: center;
  width: 100vw;
  height: 100dvh;
  background: rgba(0,0,0,.66);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.came-app-sheet-backdrop.is-open {
  display: flex;
}

.came-app-sheet {
  width: 100%;
  max-width: 760px;
  height: min(88dvh, 780px);
  max-height: calc(100dvh - env(safe-area-inset-top, 0px) - 12px);
  overflow: hidden;
  display: flex;
  flex-direction: column;
  border-radius: 34px 34px 0 0;
  background: #1c1c1e;
  border: 1px solid rgba(255,255,255,.10);
  box-shadow: 0 -22px 80px rgba(0,0,0,.45);
  transform: translateY(100%);
  transition: transform .42s cubic-bezier(.18,.88,.24,1);
}

.came-app-sheet-backdrop.is-open .came-app-sheet {
  transform: translateY(0);
}

.came-app-sheet-handle {
  width: 64px;
  height: 20px;
  margin: 8px auto 0;
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  touch-action: none;
  cursor: grab;
}

.came-app-sheet-handle::before {
  content: "";
  width: 42px;
  height: 5px;
  border-radius: 999px;
  background: rgba(255,255,255,.16);
}

.came-app-sheet-top {
  height: 62px;
  display: grid;
  grid-template-columns: 54px minmax(0,1fr) 54px;
  align-items: center;
  padding: 0 14px;
  border-bottom: 1px solid rgba(255,255,255,.08);
  flex: none;
}

.came-app-sheet-close {
  appearance: none;
  -webkit-appearance: none;
  position: relative;
  width: 40px;
  height: 40px;
  border: 0;
  border-radius: 50%;
  background: transparent;
  cursor: pointer;
}

.came-app-sheet-close span {
  position: absolute;
