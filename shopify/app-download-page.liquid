<script>
(function () {
  var page = document.getElementById('came-app-page');
  if (!page) return;

  (function collapseThemeSpacing() {
    var node = page.parentElement;
    while (node && node !== document.body) {
      node.style.paddingTop = '0px';
      node.style.marginTop = '0px';
      node = node.parentElement;
    }
  })();

  var openButton = page.querySelector('[data-came-open-guide]');
  var closeButton = page.querySelector('[data-came-close-guide]');
  var backdrop = page.querySelector('[data-came-sheet-backdrop]');
  var deviceText = page.querySelector('[data-came-app-device-text]');
  var tabs = page.querySelectorAll('[data-came-tab]');
  var tutorials = page.querySelectorAll('[data-came-tutorial]');
  var screenshotImgs = page.querySelectorAll('.came-store-screens img');
  var lightboxBackdrop = page.querySelector('[data-came-lightbox-backdrop]');
  var lightboxImg = page.querySelector('[data-came-lightbox-img]');
  var lightboxClose = page.querySelector('[data-came-lightbox-close]');
  var deferredPrompt = null;

  if (backdrop && backdrop.parentElement !== document.body) {
    document.body.appendChild(backdrop);
  }

  var sheet = backdrop ? backdrop.querySelector('.came-app-sheet') : null;
  var sheetHandle = backdrop ? backdrop.querySelector('[data-came-sheet-handle]') : null;

  function ua() {
    return navigator.userAgent || '';
  }

  function isAndroid() {
    return /Android/i.test(ua());
  }

  function isStandalone() {
    return window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;
  }

  var frontElements = [];

  function bringToFront(el) {
    if (el.parentElement !== document.body || el !== document.body.lastElementChild) {
      document.body.appendChild(el);
    }
  }

  var stackObserver = new MutationObserver(function () {
    frontElements.forEach(bringToFront);
  });

  function watchFront(el) {
    if (frontElements.indexOf(el) === -1) {
      frontElements.push(el);
    }
    bringToFront(el);
    stackObserver.observe(document.body, { childList: true });
  }

  function unwatchFront(el) {
    var index = frontElements.indexOf(el);
    if (index !== -1) {
      frontElements.splice(index, 1);
    }
    if (frontElements.length === 0) {
      stackObserver.disconnect();
    }
  }

  function openSheet() {
    watchFront(backdrop);
    backdrop.classList.add('is-open');
    backdrop.setAttribute('aria-hidden', 'false');
    document.documentElement.classList.add('came-app-lock');
  }

  function closeSheet() {
    backdrop.classList.remove('is-open');
    backdrop.setAttribute('aria-hidden', 'true');
    document.documentElement.classList.remove('came-app-lock');
    unwatchFront(backdrop);
    if (sheet) {
      sheet.style.transition = '';
      sheet.style.transform = '';
    }
  }

  if (sheet && sheetHandle) {
    var dragStartY = null;

    sheetHandle.addEventListener('pointerdown', function (event) {
      dragStartY = event.clientY;
      sheet.style.transition = 'none';
      sheetHandle.setPointerCapture(event.pointerId);
    });

    sheetHandle.addEventListener('pointermove', function (event) {
      if (dragStartY === null) return;
      var delta = event.clientY - dragStartY;
      if (delta < 0) delta = 0;
      sheet.style.transform = 'translateY(' + delta + 'px)';
    });

    function endDrag(event) {
      if (dragStartY === null) return;
      var delta = event.clientY - dragStartY;
      dragStartY = null;
      sheet.style.transition = '';

      if (delta > 110) {
        closeSheet();
      } else {
        sheet.style.transform = '';
      }
    }

    sheetHandle.addEventListener('pointerup', endDrag);
    sheetHandle.addEventListener('pointercancel', endDrag);
  }

  function openLightbox(src, alt) {
    if (!lightboxBackdrop || !lightboxImg) return;
    lightboxImg.src = src;
    lightboxImg.alt = alt || '';
    watchFront(lightboxBackdrop);
    lightboxBackdrop.classList.add('is-open');
    lightboxBackdrop.setAttribute('aria-hidden', 'false');
    document.documentElement.classList.add('came-app-lock');
  }

  function closeLightbox() {
    if (!lightboxBackdrop) return;
    lightboxBackdrop.classList.remove('is-open');
    lightboxBackdrop.setAttribute('aria-hidden', 'true');
    document.documentElement.classList.remove('came-app-lock');
    unwatchFront(lightboxBackdrop);
  }

  screenshotImgs.forEach(function (img) {
    img.addEventListener('click', function () {
      openLightbox(img.currentSrc || img.src, img.alt);
    });
  });

  if (lightboxClose) {
    lightboxClose.addEventListener('click', closeLightbox);
  }

  if (lightboxBackdrop) {
    lightboxBackdrop.addEventListener('click', function (event) {
      if (event.target === lightboxBackdrop) {
        closeLightbox();
      }
    });
  }

  function setTutorial(name) {
    tabs.forEach(function (tab) {
      tab.classList.toggle('is-active', tab.getAttribute('data-came-tab') === name);
    });

    tutorials.forEach(function (tutorial) {
      tutorial.classList.toggle('is-active', tutorial.getAttribute('data-came-tutorial') === name);
    });

    var activeTutorial = page.querySelector('[data-came-tutorial="' + name + '"]');
    if (activeTutorial) {
      activeTutorial.scrollIntoView({
        behavior: 'smooth',
        block: 'start'
      });
    }
  }

  window.addEventListener('beforeinstallprompt', function (event) {
    event.preventDefault();
    deferredPrompt = event;
  });

  window.addEventListener('appinstalled', function () {
    deferredPrompt = null;
    closeSheet();
    if (deviceText) {
      deviceText.textContent = 'App installata';
    }
  });

  if (openButton) {
    openButton.addEventListener('click', function () {
      if (isStandalone()) {
        if (deviceText) {
          deviceText.textContent = 'App già installata';
        }
        return;
      }

      if (isAndroid() && deferredPrompt) {
        deferredPrompt.prompt();

        deferredPrompt.userChoice.then(function () {
          deferredPrompt = null;
        }).catch(function () {
          deferredPrompt = null;
          openSheet();
        });

        return;
      }

      openSheet();
    });
  }

  if (closeButton) {
    closeButton.addEventListener('click', closeSheet);
  }

  if (backdrop) {
    backdrop.addEventListener('click', function (event) {
      if (event.target === backdrop) {
        closeSheet();
      }
    });
  }

  tabs.forEach(function (tab) {
    tab.addEventListener('click', function () {
      setTutorial(tab.getAttribute('data-came-tab'));
    });
  });

  if (isAndroid()) {
    tabs.forEach(function (tab) {
      var isAndroidTab = tab.getAttribute('data-came-tab') === 'android';
      tab.classList.toggle('is-active', isAndroidTab);
    });

    tutorials.forEach(function (tutorial) {
      var isAndroidTutorial = tutorial.getAttribute('data-came-tutorial') === 'android';
      tutorial.classList.toggle('is-active', isAndroidTutorial);
    });
  }
})();
</script>
