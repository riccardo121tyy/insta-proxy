{% comment %}
  sections/assistenza-template.liquid
  Support/contact page, same came- design system as home/guide/article/collection.
  Contact channels, hours and FAQ are all theme-editor settings/blocks — no
  phone numbers, emails or response times are hardcoded, since a wrong
  fabricated contact detail is worse than none. Anything left empty in the
  editor is hidden rather than shown as a placeholder.
{% endcomment %}

<style>
  .came-support,
  .came-support * {
    box-sizing: border-box;
  }

  .came-support {
    --came-bg: #000;
    --came-card: #101014;
    --came-card-2: #15151b;
    --came-text: #fff;
    --came-muted: #d5d5df;
    --came-soft: #9b9baa;
    --came-border: rgba(255,255,255,.12);
    --came-grad: linear-gradient(135deg,#E91CF9 0%,#00D8FF 100%);
    width: 100%;
    overflow: hidden;
    background: var(--came-bg);
    color: var(--came-text);
    font-family: inherit;
    padding-bottom: 90px;
  }

  .came-support-wrap {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
  }

  .came-support-section {
    padding: 40px 0;
  }

  .came-eyebrow {
    display: inline-flex;
    margin-bottom: 12px;
    font-size: 12px;
    font-weight: 950;
    letter-spacing: .09em;
    text-transform: uppercase;
    background: var(--came-grad);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .came-arrow {
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: var(--came-grad);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
    font-style: normal;
    flex: 0 0 auto;
  }

  .came-support-hero {
    padding: 58px 0 8px;
  }

  .came-support-title {
    margin: 0;
    max-width: 700px;
    color: #fff;
    font-size: clamp(34px, 5.8vw, 58px);
    line-height: .98;
    letter-spacing: -.065em;
    font-weight: 950;
    text-wrap: balance;
  }

  .came-support-sub {
    margin: 16px 0 0;
    max-width: 620px;
    color: var(--came-muted);
    font-size: clamp(15px, 2.1vw, 18px);
    line-height: 1.55;
  }

  .came-hours-badge {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-height: 40px;
    margin-top: 24px;
    padding: 0 16px;
    border-radius: 999px;
    background: rgba(255,255,255,.05);
    border: 1px solid rgba(255,255,255,.14);
    color: #fff;
    font-size: 13px;
    font-weight: 850;
  }

  .came-hours-badge:before {
    content: "";
    width: 8px;
    height: 8px;
    border-radius: 999px;
    background: var(--came-grad);
  }

  .came-section-title {
    margin: 0 0 24px;
    color: #fff;
    font-size: clamp(24px, 4.2vw, 34px);
    line-height: 1.03;
    letter-spacing: -.05em;
    font-weight: 950;
  }

  .came-channel-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .came-channel-card {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 24px;
    border-radius: 22px;
    background: var(--came-card);
    border: 1px solid var(--came-border);
    color: inherit;
    text-decoration: none;
    transition: transform .18s ease, border-color .18s ease;
  }

  .came-channel-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255,255,255,.28);
  }

  .came-channel-mark {
    width: 44px;
    height: 44px;
    border-radius: 13px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--came-grad);
    color: #fff;
    font-size: 15px;
    font-weight: 950;
  }

  .came-channel-title {
    margin: 0;
    color: #fff;
    font-size: 17px;
    font-weight: 950;
    letter-spacing: -.03em;
  }

  .came-channel-text {
    margin: 0;
    color: var(--came-muted);
    font-size: 13.5px;
    line-height: 1.45;
  }

  .came-channel-go {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-size: 12.5px;
    font-weight: 900;
  }

  .came-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 16px;
  }

  .came-step {
    padding: 24px 22px;
    border-radius: 22px;
    background: rgba(255,255,255,.035);
    border: 1px solid var(--came-border);
  }

  .came-step-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 999px;
    background: rgba(255,255,255,.07);
    border: 1px solid rgba(255,255,255,.16);
    color: #fff;
    font-size: 14px;
    font-weight: 950;
    margin-bottom: 16px;
  }

  .came-step-title {
    margin: 0;
    color: #fff;
    font-size: 16.5px;
    font-weight: 950;
    letter-spacing: -.02em;
  }

  .came-step-text {
    margin: 8px 0 0;
    color: var(--came-muted);
    font-size: 13.5px;
    line-height: 1.5;
  }

  .came-faq-list {
    display: grid;
    gap: 10px;
    max-width: 780px;
  }

  .came-faq-item {
    border-radius: 18px;
    background: rgba(255,255,255,.035);
    border: 1px solid var(--came-border);
    overflow: hidden;
  }

  .came-faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: 100%;
    padding: 18px 20px;
    background: none;
    border: 0;
    color: #fff;
    font-family: inherit;
    font-size: 15px;
    font-weight: 850;
    text-align: left;
    cursor: pointer;
  }

  .came-faq-plus {
    flex: 0 0 auto;
    width: 26px;
    height: 26px;
    border-radius: 999px;
    background: rgba(255,255,255,.08);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 15px;
    line-height: 1;
    transition: transform .18s ease;
  }

  .came-faq-item.is-open .came-faq-plus {
    transform: rotate(45deg);
    background: var(--came-grad);
  }

  .came-faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height .22s ease;
  }

  .came-faq-answer-inner {
    padding: 0 20px 18px;
    color: var(--came-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .came-explore {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    padding: 18px;
    border-radius: 20px;
    background: rgba(255,255,255,.035);
    border: 1px solid var(--came-border);
  }

  .came-explore-label {
    width: 100%;
    color: var(--came-soft);
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: .06em;
    margin-bottom: 2px;
  }

  .came-explore-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 16px;
    border-radius: 999px;
    border: 1px solid rgba(255,255,255,.14);
    background: rgba(255,255,255,.05);
    color: #fff;
    text-decoration: none;
    font-size: 13px;
    font-weight: 900;
  }

  .came-explore-pill:hover {
    background: rgba(255,255,255,.09);
  }

  @media (max-width: 980px) {
    .came-channel-grid,
    .came-steps {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 640px) {
    .came-support-wrap {
      width: min(100% - 24px, 1180px);
    }

    .came-support-section {
      padding: 30px 0;
    }

    .came-channel-grid,
    .came-steps {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .came-channel-card,
    .came-faq-plus,
    .came-faq-answer {
      transition: none;
    }
  }
</style>

<div class="came-support">
  <div class="came-support-wrap">

    <section class="came-support-hero">
      {% if section.settings.eyebrow != blank %}
        <span class="came-eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h1 class="came-support-title">{{ section.settings.heading | default: page.title }}</h1>
      {% if section.settings.subheading != blank %}
        <p class="came-support-sub">{{ section.settings.subheading }}</p>
      {% endif %}
      {% if section.settings.hours != blank %}
        <span class="came-hours-badge">{{ section.settings.hours }}</span>
      {% endif %}
    </section>

    {% assign has_channel = false %}
    {% for block in section.blocks %}
      {% if block.type == 'channel' %}{% assign has_channel = true %}{% endif %}
    {% endfor %}

    {% if has_channel %}
      <section class="came-support-section">
        <h2 class="came-section-title">{{ section.settings.channels_title | default: 'Come contattarci' }}</h2>
        <div class="came-channel-grid">
          {% for block in section.blocks %}
            {% if block.type == 'channel' %}
              <a class="came-channel-card" href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>
                <span class="came-channel-mark">{{ block.settings.mark | default: '•' }}</span>
                <h3 class="came-channel-title">{{ block.settings.title }}</h3>
                {% if block.settings.text != blank %}
                  <p class="came-channel-text">{{ block.settings.text }}</p>
                {% endif %}
                <span class="came-channel-go">{{ block.settings.cta | default: 'Contattaci' }} ›</span>
              </a>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% assign has_step = false %}
    {% for block in section.blocks %}
      {% if block.type == 'step' %}{% assign has_step = true %}{% endif %}
    {% endfor %}

    {% if has_step %}
      <section class="came-support-section">
        <h2 class="came-section-title">{{ section.settings.steps_title | default: 'Cosa succede dopo che ci scrivi' }}</h2>
        <div class="came-steps">
          {% assign step_index = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'step' %}
              {% assign step_index = step_index | plus: 1 %}
              <div class="came-step" {{ block.shopify_attributes }}>
                <span class="came-step-num">{{ step_index }}</span>
                <h3 class="came-step-title">{{ block.settings.title }}</h3>
                {% if block.settings.text != blank %}
                  <p class="came-step-text">{{ block.settings.text }}</p>
                {% endif %}
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    {% if section.settings.page_content and page.content != blank %}
      <section class="came-support-section">
        <div class="came-prose" style="color:var(--came-muted); font-size:15px; line-height:1.7; max-width:760px;">
          {{ page.content }}
        </div>
      </section>
    {% endif %}

    {% assign has_faq = false %}
    {% for block in section.blocks %}
      {% if block.type == 'faq' %}{% assign has_faq = true %}{% endif %}
    {% endfor %}

    {% if has_faq %}
      <section class="came-support-section">
        <h2 class="came-section-title">{{ section.settings.faq_title | default: 'Domande frequenti' }}</h2>
        <div class="came-faq-list" data-came-faq>
          {% for block in section.blocks %}
            {% if block.type == 'faq' %}
              <div class="came-faq-item" {{ block.shopify_attributes }}>
                <button type="button" class="came-faq-question" data-came-faq-toggle>
                  <span>{{ block.settings.question }}</span>
                  <span class="came-faq-plus">+</span>
                </button>
                <div class="came-faq-answer">
                  <div class="came-faq-answer-inner">{{ block.settings.answer }}</div>
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </section>
    {% endif %}

    <section class="came-support-section">
      <div class="came-explore">
        <span class="came-explore-label">Ti può interessare anche</span>
        <a class="came-explore-pill" href="https://www.camecompany.com/pages/tutti-i-tool-gratuiti">Strumenti gratuiti ›</a>
        <a class="came-explore-pill" href="https://www.camecompany.com/pages/f-a-q">Tutte le FAQ ›</a>
        <a class="came-explore-pill" href="https://www.camecompany.com/blogs/guide">Guide gratuite ›</a>
        <a class="came-explore-pill" href="https://www.camecompany.com/pages/richiedi-un-servizio">Richiedi un servizio ›</a>
      </div>
    </section>

  </div>
</div>

<script>
  (function () {
    var root = document.currentScript.previousElementSibling;
    if (!root || !root.classList.contains('came-support')) {
      root = document.querySelector('.came-support');
    }
    if (!root) return;

    root.querySelectorAll('[data-came-faq-toggle]').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var item = btn.closest('.came-faq-item');
        var answer = item.querySelector('.came-faq-answer');
        var isOpen = item.classList.contains('is-open');

        root.querySelectorAll('.came-faq-item.is-open').forEach(function (openItem) {
          if (openItem !== item) {
            openItem.classList.remove('is-open');
            openItem.querySelector('.came-faq-answer').style.maxHeight = '';
          }
        });

        if (isOpen) {
          item.classList.remove('is-open');
          answer.style.maxHeight = '';
        } else {
          item.classList.add('is-open');
          answer.style.maxHeight = answer.scrollHeight + 'px';
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Assistenza",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Assistenza CAME" },
    { "type": "text", "id": "heading", "label": "Titolo", "default": "Ti aiutiamo noi, senza risposte automatiche" },
    { "type": "textarea", "id": "subheading", "label": "Sottotitolo", "default": "Scrivici per dubbi su un ordine, un servizio o una guida: rispondiamo persone vere, non bot." },
    { "type": "text", "id": "hours", "label": "Orari / tempi di risposta (facoltativo, es. \"Rispondiamo entro poche ore, tutti i giorni\")" },
    { "type": "text", "id": "channels_title", "label": "Titolo sezione canali", "default": "Come contattarci" },
    { "type": "text", "id": "steps_title", "label": "Titolo sezione passaggi", "default": "Cosa succede dopo che ci scrivi" },
    { "type": "checkbox", "id": "page_content", "label": "Mostra anche il testo della pagina (dall'editor pagine)", "default": true },
    { "type": "text", "id": "faq_title", "label": "Titolo FAQ", "default": "Domande frequenti" }
  ],
  "blocks": [
    {
      "type": "channel",
      "name": "Canale di contatto",
      "settings": [
        { "type": "text", "id": "mark", "label": "Sigla (es. WA, IG, @)", "default": "→" },
        { "type": "text", "id": "title", "label": "Nome canale", "default": "WhatsApp" },
        { "type": "text", "id": "text", "label": "Descrizione breve" },
        { "type": "text", "id": "cta", "label": "Testo pulsante", "default": "Scrivici" },
        { "type": "url", "id": "url", "label": "Link (es. wa.me/..., mailto:..., link chat)" }
      ]
    },
    {
      "type": "step",
      "name": "Passaggio",
      "settings": [
        { "type": "text", "id": "title", "label": "Titolo" },
        { "type": "textarea", "id": "text", "label": "Testo" }
      ]
    },
    {
      "type": "faq",
      "name": "Domanda",
      "settings": [
        { "type": "text", "id": "question", "label": "Domanda" },
        { "type": "textarea", "id": "answer", "label": "Risposta" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Assistenza",
      "blocks": [
        { "type": "channel" },
        { "type": "channel" },
        { "type": "channel" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "faq" },
        { "type": "faq" }
      ]
    }
  ]
}
{% endschema %}
